# Configurações do Sistema de Aluguel
# Copie este arquivo para .env e ajuste os valores

# Chave secreta para sessões (gere uma chave segura para produção)
SECRET_KEY=sua-chave-secreta-super-segura-aqui

# URL do banco de dados (SQLite para desenvolvimento)
DATABASE_URL=sqlite:///aluguel.db

# Para produção com PostgreSQL:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/sistema_aluguel